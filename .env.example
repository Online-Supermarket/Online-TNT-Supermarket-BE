# TNT Supermarket — Local overrides
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.

# ── Azure PostgreSQL ─────────────────────────────────────────────────────────
# Replace <PASSWORD> with the real password from the Azure Portal App Settings
# (tnt-supermarket-catalog → Environment variables → ConnectionStrings__Catalog)
#
# If using the TNT admin user:
#   Username=TNT@tnt-supermarket-pg
#
# If using the dedicated catalog user:
#   Username=marketflow_catalog
#
CATALOG_AZURE_CONNECTION_STRING=Host=tnt-supermarket-pg.postgres.database.azure.com;Port=5432;Database=marketflow;Username=marketflow_catalog;Password=REPLACE_ME;Ssl Mode=Require;Search Path=catalog;Trust Server Certificate=false

# ── Auth / Internal ──────────────────────────────────────────────────────────
# Override only if needed locally. Defaults in docker-compose.yml are dev-safe.
# AUTH_SIGNING_KEY=development-only-change-this-signing-key-32chars
# CATALOG_INTERNAL_KEY=marketflow-internal-demo-key
