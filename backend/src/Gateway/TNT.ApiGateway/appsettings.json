{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/auth/{**catch-all}" }]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/users/{**catch-all}" }]
      },
      "product-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/products/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/products/{**catch-all}" }]
      },
      "category-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/categories/{**catch-all}" }]
      },
      "store-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/stores/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/stores/{**catch-all}" }]
      },
      "inventory-route": {
        "ClusterId": "product-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/inventory/{**catch-all}" }]
      },
      "cart-route": {
        "ClusterId": "cart-cluster",
        "Match": { "Path": "/api/carts/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/carts/{**catch-all}" }]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/orders/{**catch-all}" }]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/payments/{**catch-all}" }]
      },
      "reporting-route": {
        "ClusterId": "reporting-cluster",
        "Match": { "Path": "/api/reports/{**catch-all}" },
        "Transforms": [{ "PathPattern": "/api/reports/{**catch-all}" }]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity-destination": {
            "Address": "http://localhost:5010"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user-destination": {
            "Address": "http://localhost:5083"
          }
        }
      },
      "product-cluster": {
        "Destinations": {
          "product-destination": {
            "Address": "http://localhost:5084"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-destination": {
            "Address": "http://localhost:5267"
          }
        }
      },
      "cart-cluster": {
        "Destinations": {
          "cart-destination": {
            "Address": "http://localhost:5064"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-destination": {
            "Address": "http://localhost:5136"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-destination": {
            "Address": "http://localhost:5294"
          }
        }
      },
      "reporting-cluster": {
        "Destinations": {
          "reporting-destination": {
            "Address": "http://localhost:5163"
          }
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178"
  },
  "AllowedHosts": "*"
}
