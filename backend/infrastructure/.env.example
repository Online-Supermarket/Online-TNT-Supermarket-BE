# ─────────────────────────────────────────────────────────────────────────────
# TNT Supermarket — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Local PostgreSQL credentials used only by docker-compose.yml
POSTGRES_USER=tnt_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT Secret — must be at least 32 characters, cryptographically random
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Azure PostgreSQL runtime connections used by docker-compose.azure-db.yml.
# Runtime users must not own schemas or modify __EFMigrationsHistory.
# Keep VerifyFull enabled and use the Azure server FQDN.
TNT_IDENTITY_CONNECTION_STRING=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_identity;Username=tnt_identity_app;Password=<secret>;SSL Mode=VerifyFull;Timeout=15;Command Timeout=30;Pooling=true;Maximum Pool Size=20
TNT_USER_CONNECTION_STRING=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_user;Username=tnt_user_app;Password=<secret>;SSL Mode=VerifyFull;Timeout=15;Command Timeout=30;Pooling=true;Maximum Pool Size=20
TNT_PRODUCT_CONNECTION_STRING=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_product;Username=tnt_product_app;Password=<secret>;SSL Mode=VerifyFull;Timeout=15;Command Timeout=30;Pooling=true;Maximum Pool Size=20

# Schema-owner connections for explicit `dotnet ef` commands. Export these in
# your shell; they are intentionally not passed to runtime containers.
ConnectionStrings__IdentityDbMigrator=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_identity;Username=tnt_identity_migrator;Password=<secret>;SSL Mode=VerifyFull
ConnectionStrings__UserDbMigrator=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_user;Username=tnt_user_migrator;Password=<secret>;SSL Mode=VerifyFull
ConnectionStrings__ProductDbMigrator=Host=<server>.postgres.database.azure.com;Port=5432;Database=tnt_product;Username=tnt_product_migrator;Password=<secret>;SSL Mode=VerifyFull

# Frontend origin allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# API Gateway host port. 5150 matches the local launch profile.
API_GATEWAY_PORT=5150

# Kafka bootstrap servers (override for production)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# The legacy seed_and_test.js utility is quarantined and must not be used for
# deployment or migration. See infrastructure/README.md.
