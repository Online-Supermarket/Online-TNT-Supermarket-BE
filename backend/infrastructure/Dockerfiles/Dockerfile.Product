# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

COPY backend/src/Services/Product/TNT.ProductService.Api/TNT.ProductService.Api.csproj \
     ./backend/src/Services/Product/TNT.ProductService.Api/

RUN dotnet restore ./backend/src/Services/Product/TNT.ProductService.Api/TNT.ProductService.Api.csproj

COPY backend/src/Services/Product/ ./backend/src/Services/Product/

WORKDIR /app/backend/src/Services/Product/TNT.ProductService.Api
RUN dotnet publish -c Release -o /out --no-restore

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN addgroup --system tnt && adduser --system --ingroup tnt tnt && \
    mkdir -p /app/wwwroot/images && \
    chown -R tnt:tnt /app/wwwroot

COPY --from=build /out .
RUN chown -R tnt:tnt /app

USER tnt

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "TNT.ProductService.Api.dll"]
