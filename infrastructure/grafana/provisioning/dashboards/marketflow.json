      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "targets": [
        {
          "expr": "sum by (service) (rate(marketflow_http_request_duration_seconds_sum[5m])) / clamp_min(sum by (service) (rate(marketflow_http_request_duration_seconds_count[5m])), 0.0001)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Unpublished Outbox and Reservation Exceptions",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
